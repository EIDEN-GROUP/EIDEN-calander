# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keep the placeholder template tracked
!.env.example

# Local test artifacts
.playwright-mcp/
*.png
!public/**/*.png
!app/apple-icon.png
!app/icon*.png

# Playwright artifacts
test-results/
playwright-report/

# Impeccable audit screenshots (provenance for docs/agents/IMPECCABLE_FINDINGS.md)
audit/

# tutorial build artifacts (large binaries — regenerate with tutorial/build_video.py)
CALENDAR-tutorial.mp4
tutorial/frames/
tutorial/audio/
tutorial/_segments/
tutorial/*.png
tutorial/segments.json
