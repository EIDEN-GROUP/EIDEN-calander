# =============================================================================
# CALENDAR. by Eiden Group: environment template
# =============================================================================
# Copy to .env.local for development:   cp .env.example .env.local
# NEVER commit the copy. This file ships with placeholder values only.
# Real values are provided by the client/admin out-of-band (Vercel env scopes
# for staging/prod, 1Password for break-glass). See docs/RUNBOOK.md §5.
#
# Scope legend:
#   [public]      NEXT_PUBLIC_*: inlined into the client bundle at build time.
#                 NOT secret. Changing it requires a redeploy.
#   [server-only] Read at runtime on the server. Never sent to the browser,
#                 never logged, never prefixed NEXT_PUBLIC_.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase: project & public client config
# Get these from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# [public] Your Supabase project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# [public] Supabase anon/public key: safe to expose; Row Level Security still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# [server-only] Supabase service-role key: FULL database privileges.
# Used ONLY by lib/supabase/service.ts for user provisioning (create/ban/reset/
# deactivate). NEVER import it in client code, route handlers open to the world,
# or log statements. Rotation procedure: docs/RUNBOOK.md §9.6.
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# [server-only] Direct (non-pooled) Postgres connection string.
# Used by ops tooling only: `supabase db push`, `pg_dump` (weekly backup).
# The app itself does NOT use this at runtime (Supabase client talks to
# PostgREST; serverless invocations would exhaust connections on the free tier).
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:CHANGE_ME@db.your-project-ref.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Outbound transactional email: Hostinger SMTP (nodemailer)
# hPanel → Emails → makrich@eiden-group.com → mailbox credentials
# -----------------------------------------------------------------------------

# [server-only] SMTP host: always smtp.hostinger.com for this mailbox.
SMTP_HOST=smtp.hostinger.com

# [server-only] 587 = STARTTLS (recommended) | 465 = implicit TLS. Both work;
# the app verifies the connection on startup of the mail path and in /settings/mail.
SMTP_PORT=587

# [server-only] SMTP auth user: the full mailbox address.
SMTP_USER=makrich@eiden-group.com

# [server-only] SMTP password = the mailbox password from hPanel. Placeholder below.
SMTP_PASSWORD=CHANGE_ME

# [server-only] Sender identity for ALL outbound mail (welcome, temp password,
# change-request notifications, inbox replies). Keep the exact mailbox address.
EMAIL_FROM="Eiden Group <makrich@eiden-group.com>"

# -----------------------------------------------------------------------------
# Inbound mail: Hostinger IMAP (imapflow), the in-app Inbox
# READ / SEARCH / MARK-READ / REPLY only. No delete, no move. TLS (993) only.
# -----------------------------------------------------------------------------

# [server-only] IMAP host: always imap.hostinger.com.
IMAP_HOST=imap.hostinger.com

# [server-only] 993 = SSL/TLS. Port 143 / STARTTLS is intentionally not supported.
IMAP_PORT=993

# [server-only] IMAP auth user: same mailbox as SMTP.
IMAP_USER=makrich@eiden-group.com

# [server-only] IMAP password: usually the same mailbox password as SMTP_PASSWORD.
IMAP_PASSWORD=CHANGE_ME

# [server-only] Hard guard: the ONLY mailbox the app may ever open. Enforced as a
# constant in lib/mail; changing it requires a code change + security review,
# not just an env edit (see docs/SECURITY.md §2.7).
MAILBOX_ALLOWED=makrich@eiden-group.com

# -----------------------------------------------------------------------------
# Scheduling / automation
# -----------------------------------------------------------------------------

# [server-only] Bearer token required by /api/cron/* (e.g. change-request expiry
# sweep, optionally the keep-alive ping). Generate with: openssl rand -hex 32
# Vercel Cron sends it automatically as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=CHANGE_ME

# [server-only] Public URL of Eiden Group's business website: linked in outgoing
# emails ("Visit eiden-group.com"). NOT the app's URL (the app is
# https://calendar.eiden-group.com) and NOT used for auth callbacks.
BUSINESS_PUBLIC_URL=https://eiden-group.com

# =============================================================================
# Notes
# -----------------------------------------------------------------------------
# 1. Public vs server-only: only NEXT_PUBLIC_* reach the browser. Everything
#    else must stay on the server. Leaking any server-only value = treat as
#    compromised; rotate per docs/RUNBOOK.md §9.6.
# 2. Staging vs production: set DIFFERENT values in Vercel for Preview
#    (staging Supabase project + sandbox/test recipients) and Production
#    (prod Supabase project + real recipients). Never share.
# 3. The client provides the real values out-of-band (securely); engineers
#    never source them from this file, docs, or chat history.
# 4. Redeploy after ANY change here; NEXT_PUBLIC_* are build-time inlined.
# =============================================================================
